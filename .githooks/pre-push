#!/bin/sh
# pre-push — run the hermetic check tier before anything leaves this machine.
#
# WHY PUSH AND NOT COMMIT. The commit hook next to this one is deliberately tiny
# (an index read and a ledger read) because parallel sessions share one checkout
# and a tree-wide check at commit time would block on a peer's half-written
# file. Push is the boundary where that stops being true: it is rarer, it is
# where work becomes visible to anybody else, and a red suite arriving there is
# still cheap to fix.
#
# BLOCKS by default, unlike the claim gate. There is no false-positive question
# to measure here — a failing test is a failing test — so warn would be
# ceremony. The claim gate warns because a peer's claimed scope may legitimately
# be in your commit; a red suite is never legitimate.
#
# LOCAL:  <git-common-dir>/hooks.local/pre-push, if executable, runs first with
#         the same stdin and arguments; its failure blocks the push
# KNOBS:  BUDDY_PREPUSH_SKIP=1     skip the hermetic tier, this once
#         BUDDY_PREPUSH_CHECK=...  the command to run (the done-check stubs this,
#                                  which is also what keeps the suite from
#                                  running itself when it exercises this hook)
# BYPASS: git push --no-verify
set -eu

# Git hands the ref list on stdin once, and both readers below need it.
INPUT=$(cat)

# A MACHINE'S OWN CHECKS, kept out of the repo (see pre-commit).
# `|| true`: under set -e a failed substitution in an assignment would exit.
COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null || true)
LOCAL_HOOK=${COMMON_DIR:+$COMMON_DIR/hooks.local/pre-push}
if [ -n "$LOCAL_HOOK" ] && [ -x "$LOCAL_HOOK" ]; then
	printf '%s\n' "$INPUT" | "$LOCAL_HOOK" "$@" || exit $?
fi

if [ "${BUDDY_PREPUSH_SKIP:-}" = "1" ]; then
	exit 0
fi

# No repo, no opinion. Unlike the claim gate this cannot fail closed on a
# discovery failure: refusing to push because `rev-parse` misbehaved would strand
# work with no ledger involved and nothing to fix.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT"

# A push that deletes refs sends no commits, so there is nothing to check. Git
# feeds `<local ref> <local sha> <remote ref> <remote sha>` on stdin and uses the
# all-zero sha for a deletion; if every line is a deletion, allow.
ZERO=0000000000000000000000000000000000000000
pushing=0
while read -r _lref lsha _rref _rsha; do
	[ -n "${lsha:-}" ] || continue
	case "$lsha" in
	"$ZERO") continue ;;
	*) pushing=1 ;;
	esac
done <<REFS
$INPUT
REFS
if [ "$pushing" = "0" ]; then
	exit 0
fi

CHECK=${BUDDY_PREPUSH_CHECK:-sh scripts/check.sh hermetic}
echo "pre-push: running the hermetic tier ($CHECK)" >&2
if sh -c "$CHECK" >&2; then
	echo "pre-push: hermetic gate GREEN — push allowed." >&2
	exit 0
fi
echo "pre-push: BLOCKED — the hermetic tier is red. Fix it, or push anyway with:" >&2
echo "          git push --no-verify" >&2
exit 1
